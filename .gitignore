node_modules/
dist/
# Sinov uchun yasalgan vaqtinchalik yig'malar
dist-*/
*.db
*.db-wal
*.db-shm
.env
.claude/

# Do'kon ma'lumoti — kod emas. Git'da turmaydi, aks holda har bir rasm
# tarixga qo'shilib boradi va hech qachon o'chmaydi.
backend/uploads/

# Sertifikatlar va maxfiy kalitlar hech qachon git'ga tushmasin.
# Dev uchun HTTPS kerak bo'lsa Vite o'zi yasab beradi (npm run dev:https).
backend/certs/
*.pem
*.key
*.crt

# Android release imzosi. Bu kalit bilan istalgan odam "BuySale"
# nomidan soxta yangilanish chiqara oladi, shuning uchun u va uning
# parollari git'ga ASLO tushmasligi kerak. Kalit yo'qolsa Play
# Market'dagi ilovani boshqa hech qachon yangilab bo'lmaydi —
# nusxasini xavfsiz joyda saqlang.
*.jks
*.keystore
keystore.properties

# Yig'ilgan ilova fayllari — kod emas, har safar qaytadan yasaladi
*.apk
*.aab
*.p12
*.pfx

# Sinov suratlari — ular repozitoriyga kirmaydi
*.png
!brand/**/*.png
!miniapp/public/*.png
!admin/public/*.png
# Mobil ilova ikonkalari va splash ekranlari — bular sinov surati
# emas, ilovaning o'zi. Git'da turmasa, boshqa kompyuterda yig'ilgan
# ilova Capacitor'ning standart logosi bilan chiqib ketardi.
# (Qayta yasash: cd miniapp && npm run assets)
!miniapp/assets/*.png
!miniapp/android/app/src/main/res/**/*.png
!miniapp/ios/App/App/Assets.xcassets/**/*.png
