# Namuna — haqiqiy qiymatlarni .env ga yozing (u git'ga tushmaydi)

# Bot tokeni (BotFather beradi). Bo'sh bo'lsa Telegram bilan bog'liq
# hamma narsa jimgina o'chiq turadi: kechki hisobot, mijozga chek.
TELEGRAM_BOT_TOKEN=

# Bot nomi (@ siz). Mijozni Telegram'ga ulash havolasi shundan tuziladi:
# https://t.me/<BOT_USERNAME>?start=c<kod>
# Bo'sh bo'lsa ilova "bot nomi sozlanmagan" deb aytadi.
TELEGRAM_BOT_USERNAME=

MINIAPP_URL=https://example.com
TELEGRAM_WEBHOOK_SECRET=

# Tokenlar va mijoz havolalari shu kalit bilan imzolanadi.
# ISHLAB CHIQARISHDA ALBATTA O'ZGARTIRING — aks holda havola kodlarini
# boshqalar ham yasay oladi.
AUTH_SECRET=

# Faqat sinov uchun: Telegram API manzilini almashtiradi (soxta server).
# Ishlab chiqarishda bo'sh qoldiring.
TELEGRAM_API_BASE=

# Jurnal darajasi: info (standart), warn — ishlab chiqarish uchun,
# off — umuman yozmaslik. Ko'p foydalanuvchi bo'lganda warn tavsiya etiladi.
LOG_LEVEL=info

# FAQAT SINOV UCHUN: kirish kodini qotirib qo'yadi (masalan 123456).
# ISHLAB CHIQARISHDA BO'SH QOLDIRING — aks holda hamma do'konga bir xil
# kod ketadi va raqamni bilgan har kim begona hisobga kira oladi.
# Bo'sh bo'lsa kod har safar tasodifiy yasaladi.
OTP_DEV_CODE=

# FAQAT SINOV UCHUN: rasm olishda ichki (xususiy) manzillarga ruxsat.
# ISHLAB CHIQARISHDA BO'SH QOLDIRING — aks holda admin panel orqali
# serverning ichki tarmog'iga so'rov yuborish mumkin bo'ladi.
IMAGE_FETCH_ALLOW_PRIVATE=

# Faqat sinov uchun: Open Food Facts manzilini almashtiradi.
# Ishlab chiqarishda bo'sh qoldiring.
OFF_API_BASE=

# ─────────── AI YORDAMCHI ───────────

# Anthropic kaliti (console.anthropic.com dan olinadi).
# BO'SH BO'LSA AI BUTUNLAY O'CHIQ TURADI — ilovadagi ekran "yoqilmagan"
# deb yozadi, bot esa avvalgidek faqat qarz yozadi. Ya'ni kalitsiz
# hech narsa buzilmaydi va bir tiyin ham sarflanmaydi.
ANTHROPIC_API_KEY=

# Model. Standarti — Haiku: bitta savol ~58 so'm turadi, do'konchining
# kunlik 3 300 so'mlik to'loviga bemalol sig'adi.
# Kuchliroq model qimmatroq: Sonnet ~3 barobar, Opus ~5 barobar.
AI_MODEL=claude-haiku-4-5
AI_MODEL_DEEP=claude-sonnet-5

# Bitta do'kon kuniga nechta savol bera oladi. 0 — cheksiz (tavsiya
# etilmaydi: bitta do'kon kuniga yuz savol bersa xarajat obunadan oshadi).
AI_DAILY_LIMIT=20

# Dollar kursi — sarfni so'mda ko'rsatish uchun. Kurs o'zgarsa to'g'rilang.
AI_USD_RATE=12500

# Suhbat necha kun saqlanadi
AI_KEEP_DAYS=30

# Faqat sinov uchun: Anthropic manzilini almashtiradi (soxta server).
# Ishlab chiqarishda bo'sh qoldiring.
ANTHROPIC_BASE_URL=
