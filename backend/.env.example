# Namuna — haqiqiy qiymatlarni .env ga yozing (u git'ga tushmaydi)

# Bot tokeni (BotFather beradi). Bo'sh bo'lsa Telegram bilan bog'liq
# hamma narsa jimgina o'chiq turadi: kechki hisobot, mijozga chek.
TELEGRAM_BOT_TOKEN=

# Bot nomi (@ siz). Mijozni Telegram'ga ulash havolasi shundan tuziladi:
# https://t.me/<BOT_USERNAME>?start=c<kod>
# Bo'sh bo'lsa ilova "bot nomi sozlanmagan" deb aytadi.
TELEGRAM_BOT_USERNAME=

MINIAPP_URL=https://example.com
TELEGRAM_WEBHOOK_SECRET=

# Tokenlar va mijoz havolalari shu kalit bilan imzolanadi.
# ISHLAB CHIQARISHDA ALBATTA O'ZGARTIRING — aks holda havola kodlarini
# boshqalar ham yasay oladi.
AUTH_SECRET=

# Faqat sinov uchun: Telegram API manzilini almashtiradi (soxta server).
# Ishlab chiqarishda bo'sh qoldiring.
TELEGRAM_API_BASE=

# Jurnal darajasi: info (standart), warn — ishlab chiqarish uchun,
# off — umuman yozmaslik. Ko'p foydalanuvchi bo'lganda warn tavsiya etiladi.
LOG_LEVEL=info
